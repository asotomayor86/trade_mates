// Prisma 6 (no 7 — evita driver adapters y prisma.config.ts, innecesarios
// para este proyecto). Mismo criterio que el resto del stack de referencia.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // La integración de Neon en Vercel usa este nombre para la conexión
  // directa (sin pooling), no "DIRECT_URL".
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // Null hasta que el invitado acepta su invitación y fija su propia clave.
  passwordHash String?
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  invitationsSent Invitation[] @relation("InvitationCreator")
  invitationUsed  Invitation?  @relation("InvitationAccepted")

  alertsCreated Alert[]     @relation("AlertCreator")
  alertsSeen    AlertSeen[]

  strategiesCreated    Strategy[]              @relation("StrategyCreator")
  verificationsCreated StrategyVerification[]  @relation("VerificationCreator")
}

// Invitación de un solo uso: el admin la crea con un rol asignado, comparte
// el enlace a mano (fuera de la app, p. ej. WhatsApp), y el invitado la
// consume una única vez para crear su cuenta y fijar su propia contraseña.
model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  role        Role      @default(USER)
  expiresAt   DateTime?
  usedAt      DateTime?

  // Opcional + SetNull (no Cascade): si se borra el admin que la creó, la
  // invitación sobrevive como registro — igual criterio que "user" abajo.
  // Si estuviera pendiente (sin usar), seguiría siendo válida.
  createdById String?
  createdBy   User?   @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Se rellena al aceptar la invitación; onDelete: SetNull para que la
  // invitación (como registro histórico de auditoría) sobreviva si el user
  // se borra más adelante.
  userId String? @unique
  user   User?   @relation("InvitationAccepted", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdById])
}

enum AlertVerdict {
  CIERTA
  INCIERTA
}

enum AlertSentido {
  ALCISTA
  BAJISTA
}

enum AlertBasadoEn {
  SOPORTES_RESISTENCIAS
  ONDAS
  INDICADORES
}

// Alerta de mercado: alguien sube una captura de Snapshot con un comentario
// avisando de lo que está viendo. Queda "pendiente" hasta reviewAt (plazo
// que el propio creador fija al crearla), momento en que él mismo valora si
// fue cierta o incierta. El "visto" es independiente por usuario (AlertSeen).
model Alert {
  id       String  @id @default(cuid())
  imageUrl String
  comment  String  @db.Text

  // Los tres campos con los que se compone el título de la alerta (ver
  // composeAlertTitle en lib/alert-options.ts), p. ej. "Bitcoin alcista
  // basado en soportes y resistencias". Llevan un @default porque al
  // añadirlos ya existían alertas en producción sin estos datos; toda
  // alerta nueva los rellena siempre desde el formulario.
  symbol   String        @default("Sin especificar")
  sentido  AlertSentido  @default(ALCISTA)
  basadoEn AlertBasadoEn @default(INDICADORES)

  // Plazo de autorrevisión: lo decide el creador al crear la alerta.
  reviewAt DateTime

  // Null hasta que el creador la revisa; puede ponerse antes o después de
  // reviewAt, no hay imposición estricta del servidor sobre el momento.
  verdict   AlertVerdict?
  verdictAt DateTime?

  // Opcional + SetNull: si se borra el creador, la alerta sobrevive como
  // registro — mismo criterio que en Invitation.
  createdById String?
  createdBy   User?   @relation("AlertCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  seenBy AlertSeen[]

  @@index([createdById])
  @@index([createdAt])
}

// Marca de "visto" manual, por usuario — cada quien lleva su propio control
// de qué alertas ya ha revisado, independiente de si el creador ya dio
// veredicto.
model AlertSeen {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seenAt DateTime @default(now())

  @@unique([alertId, userId])
}

// Playbook de estrategias: ficha de referencia compartida para que el grupo
// aprenda una estrategia (no se ejecuta ni se simula, es solo contenido
// explicativo + registro manual de backtesting). `code` es una etiqueta
// corta y memorable (p. ej. "TND-LONG"); también sirve de clave para el
// seed idempotente en prisma/seed.ts.
model Strategy {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  // Resumen de una línea (se ve en las tarjetas del listado).
  resumen     String
  // Explicación completa: entrada, salida, stop, por qué funciona, cuándo
  // usarla — pensada para enseñar, no solo para documentar parámetros.
  explicacion String @db.Text

  // Null en las estrategias iniciales del seed (no las creó un usuario
  // concreto) — a diferencia de Alert/Invitation, aquí null no significa
  // "el creador se borró", así que la UI lo trata distinto ("Estrategia
  // base" en vez de "usuario eliminado").
  createdById String?
  createdBy   User?   @relation("StrategyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  verifications StrategyVerification[]

  @@index([createdById])
}

// Backtesting manual de una estrategia sobre un valor concreto: captura de
// TradingView + niveles de TP/SL usados en la prueba + cómo fue. Una
// estrategia puede tener N verificaciones. A diferencia de Alert/Invitation,
// aquí sí es Cascade: una verificación no tiene sentido sin su estrategia.
model StrategyVerification {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  imageUrl String // snapshot del backtest en TradingView (Vercel Blob)
  symbol   String // valor/activo sobre el que se probó

  // Texto libre, no numérico con unidad fija: el backtest puede expresar el
  // nivel en % ("+3%"), en precio absoluto ("1.0850") o en R-múltiplos,
  // según el activo y cómo lo haya montado quien lo prueba.
  takeProfit String
  stopLoss   String

  description String  @db.Text // cómo ha funcionado el backtesting
  pineScript  String? @db.Text // opcional: código Pine Script usado

  createdById String?
  createdBy   User?   @relation("VerificationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([strategyId])
  @@index([createdById])
}
