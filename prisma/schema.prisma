// Prisma 6 (no 7 — evita driver adapters y prisma.config.ts, innecesarios
// para este proyecto). Mismo criterio que el resto del stack de referencia.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // La integración de Neon en Vercel usa este nombre para la conexión
  // directa (sin pooling), no "DIRECT_URL".
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // Null hasta que el invitado acepta su invitación y fija su propia clave.
  passwordHash String?
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  invitationsSent Invitation[] @relation("InvitationCreator")
  invitationUsed  Invitation?  @relation("InvitationAccepted")

  alertsCreated Alert[]     @relation("AlertCreator")
  alertsSeen    AlertSeen[]
}

// Invitación de un solo uso: el admin la crea con un rol asignado, comparte
// el enlace a mano (fuera de la app, p. ej. WhatsApp), y el invitado la
// consume una única vez para crear su cuenta y fijar su propia contraseña.
model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  role        Role      @default(USER)
  expiresAt   DateTime?
  usedAt      DateTime?

  // Opcional + SetNull (no Cascade): si se borra el admin que la creó, la
  // invitación sobrevive como registro — igual criterio que "user" abajo.
  // Si estuviera pendiente (sin usar), seguiría siendo válida.
  createdById String?
  createdBy   User?   @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Se rellena al aceptar la invitación; onDelete: SetNull para que la
  // invitación (como registro histórico de auditoría) sobreviva si el user
  // se borra más adelante.
  userId String? @unique
  user   User?   @relation("InvitationAccepted", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdById])
}

enum AlertVerdict {
  CIERTA
  INCIERTA
}

enum AlertSentido {
  ALCISTA
  BAJISTA
}

enum AlertBasadoEn {
  SOPORTES_RESISTENCIAS
  ONDAS
  INDICADORES
}

// Alerta de mercado: alguien sube una captura de Snapshot con un comentario
// avisando de lo que está viendo. Queda "pendiente" hasta reviewAt (plazo
// que el propio creador fija al crearla), momento en que él mismo valora si
// fue cierta o incierta. El "visto" es independiente por usuario (AlertSeen).
model Alert {
  id       String  @id @default(cuid())
  imageUrl String
  comment  String  @db.Text

  // Los tres campos con los que se compone el título de la alerta (ver
  // composeAlertTitle en lib/alert-options.ts), p. ej. "Bitcoin alcista
  // basado en soportes y resistencias". Llevan un @default porque al
  // añadirlos ya existían alertas en producción sin estos datos; toda
  // alerta nueva los rellena siempre desde el formulario.
  symbol   String        @default("Sin especificar")
  sentido  AlertSentido  @default(ALCISTA)
  basadoEn AlertBasadoEn @default(INDICADORES)

  // Plazo de autorrevisión: lo decide el creador al crear la alerta.
  reviewAt DateTime

  // Null hasta que el creador la revisa; puede ponerse antes o después de
  // reviewAt, no hay imposición estricta del servidor sobre el momento.
  verdict   AlertVerdict?
  verdictAt DateTime?

  // Opcional + SetNull: si se borra el creador, la alerta sobrevive como
  // registro — mismo criterio que en Invitation.
  createdById String?
  createdBy   User?   @relation("AlertCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  seenBy AlertSeen[]

  @@index([createdById])
  @@index([createdAt])
}

// Marca de "visto" manual, por usuario — cada quien lleva su propio control
// de qué alertas ya ha revisado, independiente de si el creador ya dio
// veredicto.
model AlertSeen {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seenAt DateTime @default(now())

  @@unique([alertId, userId])
}
