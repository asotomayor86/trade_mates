# Postgres (Neon, vía la integración de Vercel). DATABASE_URL_UNPOOLED es
# la conexión directa (sin pooling) que usa Prisma Migrate; en local puedes
# poner el mismo valor en ambas si no tienes una URL directa distinta.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=

# Vercel Blob (Storage → Create → Blob en el panel de Vercel). Necesario
# para subir las capturas de las Alertas.
BLOB_READ_WRITE_TOKEN=

# Admin inicial (opcional; si no se define, se usan las constantes de
# prisma/seed.ts: usuario "admin", contraseña "changeme123").
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAYNAME=
